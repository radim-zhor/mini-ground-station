# ── Observer location (agent + web app) ──────────────────────────────
OBSERVER_LAT=50.08
OBSERVER_LON=14.44

# ── Agent → web app ──────────────────────────────────────────────────
APP_URL=http://localhost:8000
AGENT_SECRET=change-me-shared-secret   # must match on agent and app

# ── Web app ──────────────────────────────────────────────────────────
# DATABASE_URL=postgresql://user:pass@host/db   # defaults to local SQLite

# ── Agent / SDR ──────────────────────────────────────────────────────
MOCK=1                # 1 = synthetic IQ, no RTL-SDR hardware required
SDR_GAIN=49.6         # tuner gain in dB, or "auto" for AGC
# NTFY_TOPIC=my-ground-station         # ntfy.sh topic for pass alerts
