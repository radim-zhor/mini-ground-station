# ── Observer location (agent + web app) ──────────────────────────────
# The station is mobile: by default (OBSERVER_MODE=auto) the agent detects
# its position via IP geolocation and reports it to the web app, so the map
# and predictions follow the device. LAT/LON below are the *fallback* when
# detection fails. Set OBSERVER_MODE=manual to pin the position (e.g. VPN).
OBSERVER_MODE=auto
OBSERVER_LAT=50.08
OBSERVER_LON=14.44

# ── Agent → web app ──────────────────────────────────────────────────
APP_URL=http://localhost:8000
AGENT_SECRET=change-me-shared-secret   # must match on agent and app

# ── Web app ──────────────────────────────────────────────────────────
# DATABASE_URL=postgresql://user:pass@host/db   # defaults to local SQLite

# ── Agent / SDR ──────────────────────────────────────────────────────
MOCK=1                # 1 = synthetic IQ, no RTL-SDR hardware required
# Manual gain, not AGC: with an LNA ahead of the tuner, AGC rides the gain up
# on a high pass and overloads. 20.7 dB is verified on this station against
# Meteor and Orbcomm carriers. "auto" enables AGC (not recommended with an LNA).
SDR_GAIN=20.7
# The LNA is bias-tee powered — measured +14 dB with this on. Off (0) means the
# LNA sits in the path as an unpowered attenuator.
SDR_BIAS_TEE=1
# NTFY_TOPIC=my-ground-station         # ntfy.sh topic for pass alerts

# ── Recordings retention ─────────────────────────────────────────────
# Baseband IQ is ~3 GB per 10-minute Orbcomm pass (1.2288 Msps × 4 B). The
# agent deletes the IQ after a successful decode and drops the oldest passes
# once recordings/ exceeds this cap. Only directories the agent wrote are ever
# deleted — hand-made recordings in recordings/ are left alone.
RECORDINGS_MAX_GB=20
