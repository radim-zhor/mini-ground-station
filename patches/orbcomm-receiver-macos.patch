diff --git a/realtime_receiver.py b/realtime_receiver.py
index 8917d97..f324bd1 100644
--- a/realtime_receiver.py
+++ b/realtime_receiver.py
@@ -41,6 +41,13 @@ except:
 import signal
 from time import time, sleep
 import multiprocessing as mp
+
+# macOS (Python 3.8+) defaults to "spawn", which re-imports this module in the
+# child. This script's main loop sits at module level with no __main__ guard, so
+# the child would run the main loop instead of process_samples(): nothing ever
+# drains the queue, it fills up, and the SDR callback dies in queue.qsize()
+# (unimplemented on macOS). "fork" keeps the original Linux behaviour.
+mp.set_start_method('fork', force=True)
 from math import degrees, log10
 
 # Need this to enable ctrl+c to exit the program.
@@ -79,9 +86,15 @@ c = 299792458.0 # m/s
 # However, it is a much higher sample rate than would be needed.
 sample_rate = 1.2288e6
 center_freq = 137.5e6
-gain = 'auto' # Use AGC
+# Manual gain, not AGC: this station has an RTL-SDR Blog LNA (18.7 dB) behind a
+# FBP-137s filter (~1.5 dB loss), i.e. ~17 dB net ahead of the tuner. AGC tends
+# to ride that up and overload on a high pass; 20 dB is what worked for Meteor.
+gain = 20.7
 
 sdr = RtlSdr()
+# The LNA is bias-tee powered — without this it is an unpowered attenuator and
+# reception is worse than with no LNA at all. The stock script never sets it.
+sdr.set_bias_tee(True)
 sdr.rs = sample_rate
 sdr.gain = gain
 sdr.fc = center_freq
@@ -114,8 +127,13 @@ def rtlsdr_callback(samples, context):
     # This code will catch the case when the user closes the matplotlib figure
     if queue.full():
         # empty out the queue so that the threads can join without error
-        while queue.qsize() > 0:
-            queue.get()
+        # (qsize() raises NotImplementedError on macOS — sem_getvalue() is not
+        # available there — so drain with empty()/get_nowait() instead)
+        while not queue.empty():
+            try:
+                queue.get_nowait()
+            except Exception:
+                break
         should_finish = True
         queue.put((None, None))
         sdr.cancel_read_async()
